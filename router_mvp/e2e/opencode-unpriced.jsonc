{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [{"package":"..","options":{"allowedModels":["mock/pricey","mock/cheap"]}}],
  "model": "mock/pricey",
  "providers": {
    "mock": {
      "name": "Unpriced Fake Provider",
      "env": ["MOCK_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {"baseURL":"http://127.0.0.1:18083/v1"},
      "models": {
        "pricey": {"name":"Configured Default","capabilities":{"tools":true}},
        "cheap": {"name":"Other Unpriced Model","capabilities":{"tools":true}}
      }
    }
  }
}
