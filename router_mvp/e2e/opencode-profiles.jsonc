{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [{"package":"..","options":{"allowedModels":[
    "local/large",
    "local/small",
    "local/mid"
  ]}}],
  "model": "local/mid",
  "providers": {
    "local": {
      "name": "Offline internal Model Profile Test",
      "env": ["MOCK_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {"baseURL":"http://127.0.0.1:18083/v1"},
      "models": {
        "large": {"name":"Complex profile","capabilities":{"tools":true}},
        "small": {"name":"Simple profile","capabilities":{"tools":true}},
        "mid": {"name":"Medium profile","capabilities":{"tools":true}}
      }
    }
  }
}
