{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [{"package":"..","options":{"allowedModels":[
    "siemens/deepseek-v4.1-flash",
    "siemens/ministral-3-14b-instruct-2512",
    "siemens/qwen-3.8-27b"
  ]}}],
  "model": "siemens/qwen-3.8-27b",
  "providers": {
    "siemens": {
      "name": "Offline Siemens Model Profile Test",
      "env": ["MOCK_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {"baseURL":"http://127.0.0.1:18083/v1"},
      "models": {
        "deepseek-v4.1-flash": {"name":"Complex profile","capabilities":{"tools":true}},
        "ministral-3-14b-instruct-2512": {"name":"Simple profile","capabilities":{"tools":true}},
        "qwen-3.8-27b": {"name":"Medium profile","capabilities":{"tools":true}}
      }
    }
  }
}
